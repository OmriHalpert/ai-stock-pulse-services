# Copy to .env before running `docker compose up`. Every value below has a
# working default, so the stack boots end-to-end with zero external accounts.

# ---------- PostgreSQL ----------
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_local_password
POSTGRES_DB=stock_pulse
# Host-side port only. Services reach postgres on 5432 inside the network.
POSTGRES_PORT=5433

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
DEFAULT_USER_ID=default-user
# Comma-separated list, or * to allow any origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Frontend ----------
FRONTEND_PORT=5173

# ---------- Agent (Python worker) ----------
# Seconds between analysis cycles. 900 = every 15 minutes.
AGENT_POLL_INTERVAL_SECONDS=900
# Run one cycle immediately on startup instead of waiting for the first tick.
AGENT_RUN_ON_STARTUP=true

# Daily moves smaller than this are treated as market noise and never alerted on.
NOISE_THRESHOLD_PCT=0.5
# Absolute daily move that counts as a high-conviction momentum shift.
MOMENTUM_THRESHOLD_PCT=3.5
# Minimum hours between two alerts for the same ticker. Set to 0 for no time
# limit; repeats are still prevented by per-event de-duplication.
ALERT_COOLDOWN_HOURS=0
# How recent a headline must be to count as an event. Older news is ignored so
# last week's downgrade cannot keep re-triggering alerts.
EVENT_FRESHNESS_HOURS=36

# mock = deterministic synthetic prices (no API key needed)
# finnhub = live quotes from https://finnhub.io (free tier works)
MARKET_DATA_PROVIDER=mock
FINNHUB_API_KEY=

# Optional. Without a key the agent falls back to a deterministic rule-based verdict.
# Any OpenAI-compatible endpoint works; the defaults target OpenRouter.
#   OpenRouter -> https://openrouter.ai/api/v1  with models like openai/gpt-4o-mini
#   OpenAI     -> https://api.openai.com/v1     with models like gpt-4o-mini
# Models with a ":free" suffix on OpenRouter cost nothing but are rate limited,
# so list fallbacks. If every model fails the agent writes the verdict itself.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_FALLBACK_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free

# Optional. Without these the agent logs the alert instead of sending it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
